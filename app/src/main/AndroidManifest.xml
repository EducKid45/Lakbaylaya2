<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.lakbaylaya">

    <!-- Allow queries for SMS composer intents (smsto:) so resolveActivity works on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <!-- Permissions for map and location services -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Permissions for voice notes recording and feedback -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!-- Permissions for Bluetooth connectivity -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Permissions for notifications (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/lakbaylaya"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/lakbaylaya_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lakbaylaya">

        <!-- GEOAPIFY API key injected from local.properties via manifestPlaceholders -->
        <meta-data android:name="GEOAPIFY_API_KEY" android:value="${GEOAPIFY_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SMS result receivers (manifest-declared). They are not exported. -->
        <receiver
            android:name=".emergency.SmsSentReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.lakbaylaya.SMS_SENT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".emergency.SmsDeliveredReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.lakbaylaya.SMS_DELIVERED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>